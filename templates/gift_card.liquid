{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign gift_card_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value, shop: shop.name }}</title>
    <meta name="robots" content="noindex">
    {{ 'liftd.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="liftd-section liftd-section--ink liftd-hero" role="main">
      <div class="liftd-wrapper liftd-empty">
        <h1 class="liftd-title">{{ 'gift_cards.issued.subtext' | t }}</h1>
        <p class="liftd-lead">{{ shop.name }}</p>
        <div class="liftd-board" style="padding: 2rem; display: grid; gap: 0.75rem; justify-items: center;">
          <p class="liftd-subhead">{{ gift_card.balance | money }}</p>
          <p class="liftd-price" style="letter-spacing: 0.12em;">{{ gift_card.code | format_code }}</p>
          {%- if gift_card.expired -%}
            <p class="liftd-chip">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- endif -%}
        </div>
        <a href="{{ shop.url }}" class="liftd-btn liftd-btn--pink">{{ 'gift_cards.issued.shop_link' | t }}</a>
      </div>
    </main>
  </body>
</html>
