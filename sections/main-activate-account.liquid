<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper" style="max-width: 30rem;">
    <h1 class="liftd-title" style="margin-bottom: 2rem;">{{ 'customer.activate.title' | t }}</h1>

    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="liftd-field">
        <label for="ActivatePassword">{{ 'customer.fields.password' | t }}</label>
        <input id="ActivatePassword" class="liftd-input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="liftd-field">
        <label for="ActivatePasswordConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
        <input id="ActivatePasswordConfirm" class="liftd-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <button type="submit" class="liftd-btn liftd-btn--pink">{{ 'customer.activate.submit' | t }}</button>
        <button type="submit" name="decline" class="liftd-btn">{{ 'customer.activate.decline' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Activate account",
  "settings": []
}
{% endschema %}
