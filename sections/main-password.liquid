<section class="liftd-section liftd-section--ink liftd-hero">
  <div class="liftd-wrapper liftd-empty">
    <div class="liftd-header__logo" style="color: var(--paper);">
      {% render 'liftd-logo' %}
    </div>
    <h1 class="liftd-title">{{ 'general.password.title' | t }}</h1>
    <p class="liftd-lead">{{ 'general.password.subtext' | t }}</p>

    {%- form 'storefront_password', style: 'max-width: 26rem; width: 100%; display: flex; gap: 0.75rem;' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'general.password.label' | t }}</label>
      <input
        id="Password"
        class="liftd-input"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="{{ 'general.password.label' | t }}"
      >
      <button type="submit" class="liftd-btn liftd-btn--pink" style="color: var(--ink);">
        {{ 'general.password.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
