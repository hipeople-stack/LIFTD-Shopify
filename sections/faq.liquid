<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-headline--sub liftd-reveal" style="margin-bottom: 2rem;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <details class="liftd-faq liftd-reveal" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="liftd-faq__body liftd-prose">
          {{ block.settings.answer }}
        </div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's in a can?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>3mg THC + 9mg CBG per 12oz can. Hemp-derived THC. Zero alcohol.</p>",
          "info": "Approved product facts only. No calories, no onset times, no therapeutic claims. Three sentences on the science, then stop."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [{ "type": "question" }]
    }
  ]
}
{% endschema %}
