{%- liquid
  assign world = product.metafields.custom.flavour_world | default: ''
-%}
<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-headline--sub liftd-reveal" style="margin-bottom: 2rem;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- for i in (1..3) -%}
      {%- liquid
        assign q_field = 'faq' | append: i | append: '_q'
        assign a_field = 'faq' | append: i | append: '_a'
        capture q
          render 'liftd-flavour-copy', world: world, field: q_field
        endcapture
        assign q = q | strip
        capture a
          render 'liftd-flavour-copy', world: world, field: a_field
        endcapture
        assign a = a | strip
      -%}
      {%- if q != blank -%}
        <details class="liftd-faq liftd-reveal">
          <summary>{{ q }}</summary>
          <div class="liftd-faq__body liftd-prose">
            <p>{{ a }}</p>
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.more_label != blank -%}
      <p class="liftd-faq-more liftd-reveal">
        <a href="{{ section.settings.more_link | default: settings.main_site_url }}" class="liftd-textlink">
          {{ section.settings.more_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Straight answers."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "More link label",
      "default": "All the questions, answered"
    },
    {
      "type": "url",
      "id": "more_link",
      "label": "More link",
      "info": "Defaults to the main site URL."
    }
  ]
}
{% endschema %}
