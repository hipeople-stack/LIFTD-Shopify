{% comment %}
  Side-by-side flavour comparison. The catalog is fixed at four flavours
  (CLAUDE.md), so the table is static curated copy — no product facts,
  no numbers, nothing compliance-sensitive.
{% endcomment %}
<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    {%- if section.settings.eyebrow != blank -%}
      <p class="liftd-eyebrow liftd-reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-reveal" style="margin: 0.5rem 0 2.5rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="liftd-compare-wrap liftd-reveal">
      <table class="liftd-compare">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Attribute</span></th>
            <th scope="col">Just Orange</th>
            <th scope="col">Grape</th>
            <th scope="col">Blue Rizz</th>
            <th scope="col">Punch</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Profile</th>
            <td>Bright, clean citrus</td>
            <td>Deep and round</td>
            <td>Sweet-tart</td>
            <td>Full fruit</td>
          </tr>
          <tr>
            <th scope="row">Sweetness</th>
            <td>Low</td>
            <td>Medium</td>
            <td>Medium</td>
            <td>Medium-high</td>
          </tr>
          <tr>
            <th scope="row">Best for</th>
            <td>Daytime</td>
            <td>Evening</td>
            <td>Anytime</td>
            <td>Groups</td>
          </tr>
          <tr>
            <th scope="row">Vibe</th>
            <td>Refreshing</td>
            <td>Legendary</td>
            <td>Undefeated</td>
            <td>Nostalgic</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Flavour compare",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Scan the field"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Side by side."
    }
  ],
  "presets": [{ "name": "Flavour compare" }]
}
{% endschema %}
