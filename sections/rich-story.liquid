<section
  class="liftd-section"
  {% if section.settings.world != 'spine' %}data-liftd-world="{{ section.settings.world }}"{% endif %}
>
  <div class="liftd-wrapper">
    {%- if section.settings.eyebrow != blank -%}
      <p class="liftd-eyebrow liftd-reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-reveal" style="margin: 0.5rem 0 2rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="liftd-copy liftd-copy--auto liftd-prose liftd-reveal">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    {
      "type": "select",
      "id": "world",
      "label": "Ground",
      "options": [
        { "value": "spine", "label": "Ink (default)" },
        { "value": "just-orange", "label": "Just Orange world" },
        { "value": "grape", "label": "Grape world" },
        { "value": "blue-rizz", "label": "Blue Rizz world" },
        { "value": "punch", "label": "Punch world" }
      ],
      "default": "spine",
      "info": "Worlds are locked background/ink pairs. Body copy in Blue Rizz and Punch renders on a cream panel automatically."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We didn't reinvent soda."
    }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "Story",
      "blocks": [{ "type": "text" }]
    }
  ]
}
{% endschema %}
