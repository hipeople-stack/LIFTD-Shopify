<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    <h1 class="liftd-title" style="margin-bottom: 2rem;">{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 32rem; display: flex; gap: 0.75rem; margin-bottom: 3rem;">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
      <input
        id="SearchInput"
        class="liftd-input"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
      >
      <button type="submit" class="liftd-btn liftd-btn--pink">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="liftd-lead">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="liftd-eyebrow" style="margin-bottom: 1.5rem;">
          {{ 'general.search.results_count' | t: count: search.results_count }}
        </p>
        {%- paginate search.results by 12 -%}
          <div class="liftd-grid">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {% render 'liftd-product-card', card_product: result %}
              {%- else -%}
                <a href="{{ result.url }}" class="liftd-card liftd-reveal" style="--world-bg: var(--paper); --world-ink: var(--ink);">
                  <div class="liftd-product-card__body">
                    <h2 class="liftd-product-card__title" style="font-size: 1.4rem;">{{ result.title }}</h2>
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'liftd-pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
