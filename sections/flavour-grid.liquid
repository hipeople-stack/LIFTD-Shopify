{%- comment -%}
  The lineup is four flavours in two strengths. Cards are grouped by
  strength (5MG, then 10MG) and ordered by flavour inside each group, so
  the grid reads the same however Shopify sorts the collection.
  "Maximum flavours per strength" caps each group.

  Matches the stayliftd.com shop section: "Two strengths. Same four
  flavors." with a banner per strength (big number, per-can numbers,
  pitch) over its four cards, then the retired-3mg note. The banner copy
  comes from liftd-strength, so no number is typed into the customizer.
{%- endcomment -%}
{%- liquid
  if section.settings.collection != blank
    assign products = section.settings.collection.products
  else
    assign products = collections.all.products
  endif
  assign flavour_order = 'just-orange,grape,blue-rizz,punch' | split: ','
  assign strength_order = '5mg,10mg' | split: ','
  assign rendered_any = false
-%}
<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    {%- if section.settings.eyebrow != blank -%}
      <p class="liftd-eyebrow liftd-reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-reveal" style="margin: 0.5rem 0 0;">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_line_2 != blank -%}<br>{{ section.settings.heading_line_2 }}{%- endif -%}
      </h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="liftd-lead liftd-reveal" style="margin-top: 1.5rem;">{{ section.settings.lead }}</p>
    {%- endif -%}

    {%- for group_key in strength_order -%}
      {%- liquid
        assign group_count = 0
        capture group_cards
          for flavour in flavour_order
            if group_count >= section.settings.limit
              break
            endif
            for candidate in products
              capture candidate_world
                render 'liftd-world', product: candidate
              endcapture
              assign candidate_world = candidate_world | strip
              if candidate_world != flavour
                continue
              endif
              capture candidate_key
                render 'liftd-strength', product: candidate, field: 'key'
              endcapture
              assign candidate_key = candidate_key | strip
              if candidate_key == group_key
                render 'liftd-product-card', card_product: candidate
                assign group_count = group_count | plus: 1
                break
              endif
            endfor
          endfor
        endcapture
        capture group_label
          render 'liftd-strength', strength_key: group_key, field: 'label'
        endcapture
        assign group_label = group_label | strip
        capture group_facts
          render 'liftd-strength', strength_key: group_key, field: 'facts'
        endcapture
        assign group_facts = group_facts | strip
        capture group_pitch
          render 'liftd-strength', strength_key: group_key, field: 'pitch'
        endcapture
        assign group_pitch = group_pitch | strip
      -%}
      {%- if group_count > 0 -%}
        {%- assign rendered_any = true -%}
        <div class="liftd-strength-group liftd-strength-group--{{ group_key }}">
          <div class="liftd-strength-banner liftd-reveal">
            <h3 class="liftd-strength-banner__number">{{ group_label }}</h3>
            <div class="liftd-strength-banner__copy">
              <p class="liftd-strength-banner__facts">{{ 'products.strength.per_can' | t: facts: group_facts }}</p>
              <p class="liftd-strength-banner__pitch">{{ group_pitch }}</p>
            </div>
          </div>
          <div class="liftd-grid">
            {{ group_cards }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- unless rendered_any -%}
      <p class="liftd-body">{{ 'sections.flavour_grid.empty' | t }}</p>
    {%- endunless -%}

    {%- if rendered_any and section.settings.show_retired_note -%}
      <p class="liftd-strength-retired liftd-reveal">
        {{ 'sections.flavour_grid.retired' | t }}
        <a href="{{ settings.main_site_url | append: '/coa' }}" class="liftd-textlink">{{ 'sections.flavour_grid.lab_link' | t }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Flavour grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Four flavors"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All the flavor."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead paragraph"
    },
    {
      "type": "checkbox",
      "id": "show_retired_note",
      "label": "Show the retired 3mg note",
      "info": "History only: tells shoppers the original 3mg THC + 9mg CBG formula is retired and links to its lab reports.",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum flavours per strength",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "Flavour grid" }]
}
{% endschema %}
