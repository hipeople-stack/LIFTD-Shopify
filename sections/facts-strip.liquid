{% comment %}
  Approved product facts as benefit pills. The wordings are locked — this
  section deliberately has no free-text settings so unapproved numbers can't
  be introduced from the customizer.
{% endcomment %}
<section class="liftd-section liftd-section--ink" style="padding-block: clamp(2rem, 4vw, 3rem);">
  <div class="liftd-wrapper">
    <ul class="liftd-compliance__facts" role="list" style="margin: 0; justify-content: center;">
      <li class="liftd-pill">3mg THC + 9mg CBG per 12oz can</li>
      <li class="liftd-pill">Hemp-derived THC</li>
      <li class="liftd-pill">Zero alcohol</li>
      <li class="liftd-pill">21+ only</li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Facts strip",
  "settings": [],
  "presets": [{ "name": "Facts strip" }]
}
{% endschema %}
