{%- if section.settings.text != blank -%}
  <div class="liftd-announcement" role="region" aria-label="{{ 'sections.announcement.aria_label' | t }}">
    {{ section.settings.text }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Tastes like then. Hits like now.",
      "info": "Product facts must use the approved wordings only. Never state shipping availability without the state-law qualifier."
    }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
