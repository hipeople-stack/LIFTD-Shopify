{% comment %}
  Closing call-to-action band (ink ground). Two buttons: order + store locator.
{% endcomment %}
<section class="liftd-section liftd-section--ink">
  <div class="liftd-wrapper">
    <div class="liftd-band liftd-reveal">
      <div class="liftd-band__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="liftd-headline liftd-headline--sub">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="liftd-lead">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="liftd-actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="liftd-btn liftd-btn--pink">
            {{ section.settings.primary_label }} <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="liftd-btn liftd-btn--paper">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Can't pick one?"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Grab a 4-pack of each and try the whole lineup."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Order LIFTD"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Find it near you"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
