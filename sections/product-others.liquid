{%- liquid
  if section.settings.collection != blank
    assign pool = section.settings.collection.products
  else
    assign pool = collections.all.products
  endif
-%}
<section class="liftd-section liftd-section--ink">
  <div class="liftd-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="liftd-headline liftd-headline--sub liftd-reveal" style="margin-bottom: 2.5rem;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="liftd-mini-grid">
      {%- assign shown = 0 -%}
      {%- for other in pool -%}
        {%- if other.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign other_world = other.metafields.custom.flavour_world | default: other.handle -%}
        {%- assign other_title = other.title | split: '·' | first | strip -%}
        <a
          href="{{ other.url }}"
          class="liftd-mini liftd-reveal"
          {% if other_world != blank %}data-liftd-world="{{ other_world }}"{% endif %}
        >
          <div class="liftd-mini__media">
            {%- if other.featured_image -%}
              {{
                other.featured_image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(min-width: 60rem) 18rem, 45vw',
                  alt: other.featured_image.alt | default: other.title,
                  loading: 'lazy'
              }}
            {%- endif -%}
          </div>
          <div class="liftd-mini__bar">
            <span>{{ other_title }}</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    <div class="liftd-actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="liftd-btn liftd-btn--pink">
          {{ section.settings.primary_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="liftd-btn liftd-btn--paper">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Try the others",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try the others."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use all products."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the lineup"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Find it near you"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ]
}
{% endschema %}
