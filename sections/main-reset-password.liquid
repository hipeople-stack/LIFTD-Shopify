<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper" style="max-width: 30rem;">
    <h1 class="liftd-title" style="margin-bottom: 2rem;">{{ 'customer.reset_password.title' | t }}</h1>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="liftd-field">
        <label for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
        <input id="ResetPassword" class="liftd-input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="liftd-field">
        <label for="ResetPasswordConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
        <input id="ResetPasswordConfirm" class="liftd-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="liftd-btn liftd-btn--pink">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
