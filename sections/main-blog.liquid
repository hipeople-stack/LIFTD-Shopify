<section class="liftd-section liftd-section--paper">
  <div class="liftd-wrapper">
    <h1 class="liftd-title" style="margin-bottom: 2rem;">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="liftd-grid">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="liftd-card liftd-reveal" style="--world-bg: var(--paper); --world-ink: var(--ink);">
            {%- if article.image -%}
              <div class="liftd-product-card__media">
                {{ article.image | image_url: width: 900 | image_tag: alt: article.image.alt }}
              </div>
            {%- endif -%}
            <div class="liftd-product-card__body">
              <p class="liftd-eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</p>
              <h2 class="liftd-product-card__title" style="font-size: 1.4rem;">{{ article.title }}</h2>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {% render 'liftd-pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
