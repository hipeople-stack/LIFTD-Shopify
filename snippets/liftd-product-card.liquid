{% comment %}
  Product card (home catalog grid, collection pages). The world takeover
  comes from data-liftd-world — the card never knows a hex value.
  Accepts: card_product (product object)

  Both strengths of a flavour share its world; the strength shows as a
  label next to the title and as the THC + CBG line. The card carries its
  own price and Add, the same as the stayliftd.com shop cards. The Add form
  is a plain `data-ajax-add` product form, so assets/liftd.js sends it to
  the shared cart (or the native cart when the shared cart is off).

  Markup note: the card is an article, not one big link — a form can't
  live inside an anchor. The image and the title link to the product.
{% endcomment %}
{%- liquid
  capture world
    render 'liftd-world', product: card_product
  endcapture
  assign world = world | strip
  capture strength_label
    render 'liftd-strength', product: card_product, field: 'label'
  endcapture
  assign strength_label = strength_label | strip
  capture strength_facts
    render 'liftd-strength', product: card_product, field: 'facts'
  endcapture
  assign strength_facts = strength_facts | strip
  assign card_title = card_product.title | split: '·' | first | strip
  assign card_name = card_title | append: ' ' | append: strength_label
  assign variant = card_product.selected_or_first_available_variant
  capture tag
    render 'liftd-flavour-copy', world: world, field: 'tag'
  endcapture
  assign tag = tag | strip
  capture tagline
    render 'liftd-flavour-copy', world: world, field: 'tagline'
  endcapture
  assign tagline = tagline | strip
-%}
<article
  class="liftd-flavour-card liftd-reveal"
  {% if world != blank %}data-liftd-world="{{ world }}"{% endif %}
>
  <a href="{{ card_product.url }}" class="liftd-flavour-card__media" tabindex="-1" aria-hidden="true">
    {%- if tag != blank -%}
      <span class="liftd-chip liftd-flavour-card__tag">{{ tag }}</span>
    {%- endif -%}
    {%- if card_product.featured_image -%}
      {{
        card_product.featured_image
        | image_url: width: 900
        | image_tag:
          widths: '450, 700, 900',
          sizes: '(min-width: 60rem) 22rem, 90vw',
          alt: ''
      }}
    {%- endif -%}
  </a>
  <div class="liftd-flavour-card__body">
    <h3 class="liftd-flavour-card__title">
      <a href="{{ card_product.url }}" class="liftd-flavour-card__name">
        {{- card_title }} <span class="liftd-chip liftd-flavour-card__strength">{{ strength_label }}</span>
      </a>
    </h3>
    <p class="liftd-flavour-card__facts">{{ 'products.strength.per_can' | t: facts: strength_facts }}</p>
    {%- if tagline != blank -%}
      <p class="liftd-flavour-card__tagline">{{ tagline }}</p>
    {%- endif -%}
    {%- if variant.available -%}
      {%- form 'product', card_product, data-ajax-add: 'true', class: 'liftd-flavour-card__buy' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <p class="liftd-flavour-card__price">{% render 'liftd-price', item: variant %}</p>
        <button
          type="submit"
          class="liftd-btn liftd-btn--ink liftd-flavour-card__add"
          aria-label="{{ 'products.card.add_label' | t: title: card_name }}"
          data-adding-text="{{ 'products.add_to_cart_loading' | t }}"
          data-added-text="{{ 'products.added_to_cart' | t }}"
        >
          {{ 'products.card.add' | t }}
        </button>
        <p
          class="liftd-flavour-card__status"
          data-add-status
          data-added-text="{{ 'products.card.added_status' | t: title: card_name }}"
          role="status"
          aria-live="polite"
        ></p>
      {%- endform -%}
    {%- else -%}
      <div class="liftd-flavour-card__buy">
        <p class="liftd-flavour-card__price">{% render 'liftd-price', item: variant %}</p>
        <span class="liftd-flavour-card__soldout">{{ 'products.sold_out' | t }}</span>
      </div>
    {%- endif -%}
  </div>
</article>
